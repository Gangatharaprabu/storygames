{
  "name": "storygames",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "storygames": "node packages/cli/bin/storygames.mjs",
    "build:test-story": "node packages/cli/bin/storygames.mjs build fixtures/test-story --library fixtures/library --out packages/player/public/packs/test-story",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:test-story && pnpm --filter @storygames/player build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm --filter @storygames/player test:e2e",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm check:boundaries && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "sharp": "^0.35.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
